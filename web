<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Monthly Habit Tracker</title>
  <style>
    :root {
      --primary: #4f46e5;
      --bg: #f8fafc;
      --border: #e2e8f0;
      --text: #1e293b;
      --complete-bg: #fef9c3;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      margin: 0;
      padding: 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .container {
      width: 100%;
      max-width: 1280px;
      background: white;
      padding: 24px;
      border-radius: 16px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      flex-wrap: wrap;
      gap: 10px;
    }

    h1 {
      margin: 0;
      font-size: 1.5rem;
    }

    .controls {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    select, button {
      padding: 8px 12px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 0.95rem;
      background: white;
      color: var(--text);
      cursor: pointer;
    }

    select:focus {
      outline: 2px solid var(--primary);
    }

    button.reset-btn {
      color: #ef4444;
      border-color: #fecaca;
    }

    button.reset-btn:hover {
      background: #fef2f2;
    }

    .table-wrapper {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: 8px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: center;
      font-size: 0.9rem;
    }

    th, td {
      border: 1px solid var(--border);
      padding: 8px 4px;
      min-width: 32px;
    }

    th {
      background-color: #f1f5f9;
      font-weight: 600;
      position: sticky;
      top: 0;
      z-index: 1;
      vertical-align: middle;
    }

    /* Sticky Date Column */
    th:first-child, td:first-child {
      position: sticky;
      left: 0;
      background-color: #f8fafc;
      font-weight: bold;
      min-width: 75px;
      z-index: 2;
    }

    /* Editable Habit Input */
    .habit-input {
      width: 105px;
      border: none;
      background: transparent;
      text-align: center;
      font-weight: 600;
      font-size: 0.82rem;
      line-height: 1.25;
      color: var(--text);
      padding: 4px;
      border-radius: 4px;
    }

    .habit-input:focus {
      outline: 2px solid var(--primary);
      background: white;
    }

    /* Checkbox Style */
    input[type="checkbox"] {
      width: 18px;
      height: 18px;
      accent-color: var(--primary);
      cursor: pointer;
      vertical-align: middle;
    }

    /* Status Emoji Column */
    .status-col {
      min-width: 60px;
      font-size: 1.3rem;
      background-color: #fafafa;
    }

    tr.completed-row {
      background-color: var(--complete-bg);
      transition: background-color 0.3s ease;
    }

    tr.completed-row td:first-child {
      background-color: #fef08a;
    }

    .emoji-pop {
      display: inline-block;
      animation: pop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @keyframes pop {
      0% { transform: scale(0); }
      80% { transform: scale(1.3); }
      100% { transform: scale(1); }
    }

    .guide {
      margin-top: 12px;
      font-size: 0.85rem;
      color: #64748b;
    }
  </style>
</head>
<body>

<div class="container">
  <header>
    <h1>📅 Monthly 10-Habit Tracker</h1>
    <div class="controls">
      <select id="monthSelect" aria-label="Month"></select>
      <select id="yearSelect" aria-label="Year"></select>
      <button class="reset-btn" onclick="resetCurrentMonth()">Reset Month</button>
    </div>
  </header>

  <div class="table-wrapper">
    <table id="trackerTable">
      <thead>
        <tr id="headerRow">
          <th>Date</th>
          <!-- 10 habit headers generated by JS -->
          <th class="status-col">Done</th>
        </tr>
      </thead>
      <tbody id="trackerBody">
        <!-- Daily rows generated by JS -->
      </tbody>
    </table>
  </div>

  <p class="guide">💡 Click on any <b>habit name</b> at the top to edit it. All progress is automatically saved in your browser.</p>
</div>

<script>
  const HABIT_COUNT = 10;
  const DEFAULT_HABITS = [
    "Running & Home Workout",
    "Foreign Language Listening & Reading",
    "EEA",
    "30 Chinese Words",
    "No Snacks",
    "World Studies",
    "Read 10m",
    "Memorize 3 Cube Algorithms",
    "Craftsman Information Processing",
    "Drink Water"
  ];
  const CELEBRATION_EMOJIS = ["🎉", "🔥", "🏆", "🥳", "🌟", "💯", "👑", "✨"];
  const MONTH_NAMES = [
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December"
  ];

  const monthSelect = document.getElementById("monthSelect");
  const yearSelect = document.getElementById("yearSelect");
  const headerRow = document.getElementById("headerRow");
  const trackerBody = document.getElementById("trackerBody");

  // Initialize Month & Year English Dropdowns
  function initMonthSelectors() {
    const now = new Date();
    const currentYear = now.getFullYear();
    const currentMonth = String(now.getMonth() + 1).padStart(2, "0");

    MONTH_NAMES.forEach((name, idx) => {
      const opt = document.createElement("option");
      const val = String(idx + 1).padStart(2, "0");
      opt.value = val;
      opt.textContent = name;
      if (val === currentMonth) opt.selected = true;
      monthSelect.appendChild(opt);
    });

    for (let y = currentYear - 3; y <= currentYear + 3; y++) {
      const opt = document.createElement("option");
      opt.value = String(y);
      opt.textContent = String(y);
      if (y === currentYear) opt.selected = true;
      yearSelect.appendChild(opt);
    }

    monthSelect.addEventListener("change", renderTable);
    yearSelect.addEventListener("change", renderTable);
  }

  function getSelectedMonth() {
    return `${yearSelect.value}-${monthSelect.value}`;
  }

  // Load saved habit names
  function getHabits() {
    const saved = localStorage.getItem("habitNames_en_v2");
    return saved ? JSON.parse(saved) : [...DEFAULT_HABITS];
  }

  // Save edited habit name
  function saveHabitName(index, value) {
    const habits = getHabits();
    habits[index] = value.trim() || `Habit ${index + 1}`;
    localStorage.setItem("habitNames_en_v2", JSON.stringify(habits));
  }

  // Load monthly check data
  function getMonthData(monthKey) {
    const saved = localStorage.getItem(`habitData_en_${monthKey}`);
    return saved ? JSON.parse(saved) : {};
  }

  // Save monthly check data
  function saveMonthData(monthKey, data) {
    localStorage.setItem(`habitData_en_${monthKey}`, JSON.stringify(data));
  }

  // Render table
  function renderTable() {
    const monthKey = getSelectedMonth();
    const [year, month] = monthKey.split("-").map(Number);
    const daysInMonth = new Date(year, month, 0).getDate();
    const habits = getHabits();
    const monthData = getMonthData(monthKey);

    // 1. Render Headers
    headerRow.innerHTML = `<th>Date</th>`;
    habits.forEach((habit, idx) => {
      const th = document.createElement("th");
      const input = document.createElement("input");
      input.type = "text";
      input.className = "habit-input";
      input.value = habit;
      input.title = "Click to edit habit name";
      input.addEventListener("change", (e) => saveHabitName(idx, e.target.value));
      th.appendChild(input);
      headerRow.appendChild(th);
    });
    const statusTh = document.createElement("th");
    statusTh.className = "status-col";
    statusTh.textContent = "Done";
    headerRow.appendChild(statusTh);

    // 2. Render Daily Rows
    trackerBody.innerHTML = "";
    const dayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

    for (let day = 1; day <= daysInMonth; day++) {
      const tr = document.createElement("tr");
      const dateObj = new Date(year, month - 1, day);
      const dayOfWeek = dayNames[dateObj.getDay()];

      // Date Cell
      const dateTd = document.createElement("td");
      dateTd.textContent = `${day} (${dayOfWeek})`;
      if (dateObj.getDay() === 0) dateTd.style.color = "#ef4444"; // Sunday red
      if (dateObj.getDay() === 6) dateTd.style.color = "#3b82f6"; // Saturday blue
      tr.appendChild(dateTd);

      const dayChecks = monthData[day] || Array(HABIT_COUNT).fill(false);

      // 10 Checkbox Cells
      for (let h = 0; h < HABIT_COUNT; h++) {
        const td = document.createElement("td");
        const checkbox = document.createElement("input");
        checkbox.type = "checkbox";
        checkbox.checked = !!dayChecks[h];

        checkbox.addEventListener("change", () => {
          const currentData = getMonthData(monthKey);
          if (!currentData[day]) currentData[day] = Array(HABIT_COUNT).fill(false);
          currentData[day][h] = checkbox.checked;
          saveMonthData(monthKey, currentData);
          updateRowStatus(tr, currentData[day], day);
        });

        td.appendChild(checkbox);
        tr.appendChild(td);
      }

      // Rightmost Emoji Cell
      const statusTd = document.createElement("td");
      statusTd.className = "status-col";
      tr.appendChild(statusTd);

      updateRowStatus(tr, dayChecks, day);
      trackerBody.appendChild(tr);
    }
  }

  // Update row highlight & emoji when all 10 habits are checked
  function updateRowStatus(tr, dayChecks, day) {
    const statusTd = tr.lastElementChild;
    const isAllCompleted = dayChecks.length === HABIT_COUNT && dayChecks.every(Boolean);

    if (isAllCompleted) {
      tr.classList.add("completed-row");
      const emoji = CELEBRATION_EMOJIS[day % CELEBRATION_EMOJIS.length];
      statusTd.innerHTML = `<span class="emoji-pop">${emoji}</span>`;
    } else {
      tr.classList.remove("completed-row");
      statusTd.textContent = "";
    }
  }

  // Reset current month's data
  function resetCurrentMonth() {
    const monthKey = getSelectedMonth();
    const monthLabel = `${MONTH_NAMES[Number(monthSelect.value) - 1]} ${yearSelect.value}`;
    if (confirm(`Reset all checkmarks for ${monthLabel}?`)) {
      localStorage.removeItem(`habitData_en_${monthKey}`);
      renderTable();
    }
  }

  // Initialize and render
  initMonthSelectors();
  renderTable();
</script>

</body>
</html>
